{
  "name": "tarkov-loot-optimiser",
  "productName": "Tarkov Loot Optimiser",
  "version": "1.39.0",
  "description": "Rank Escape from Tarkov loot by value per inventory slot using live flea and trader prices.",
  "author": "will123sykv",
  "private": true,
  "main": "./out/main/index.js",
  "homepage": "https://github.com/will123sykv/Tarkov-app",
  "repository": {
    "type": "git",
    "url": "https://github.com/will123sykv/Tarkov-app.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:api": "tsx scripts/smoke-api.ts",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "release": "electron-vite build && electron-builder --win --publish always",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "data:containers": "tsx scripts/build-container-loot.ts",
    "data:container-images": "tsx scripts/fetch-container-images.ts",
    "data:maps": "tsx scripts/build-map-configs.ts"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "electron-updater": "^6.8.9",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@mdi/js": "^7.4.47",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "leaflet": "^1.9.4",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.2",
    "zustand": "^5.0.15"
  }
}
